#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "$0")"
mkdir -p data
export BASQARU_TOKEN="$(python3 -c 'import secrets; print(secrets.token_hex(24))')"
export BASQARU_PORT="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')"
export BASQARU_API_URL="http://127.0.0.1:$BASQARU_PORT"
python3 service/server.py >data/service.log 2>&1 &
relay_pid=$!
trap 'kill "$relay_pid" 2>/dev/null || true' EXIT
for attempt in {1..50}; do
  if curl -fsS "$BASQARU_API_URL/health" >/dev/null 2>&1; then break; fi
  sleep 0.1
done
if [[ -x build/Basqaru.x86_64 ]]; then
  build/Basqaru.x86_64 "$@"
else
  "${GODOT_BIN:-/home/yernur/.local/bin/godot}" --path game "$@"
fi
